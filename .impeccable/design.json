      "css": ".ds-language{display:flex;width:118px;height:28px;border-radius:8px;background:#F1F3F7}.ds-language-item{font-family:\"SF Pro Text\",-apple-system,BlinkMacSystemFont,sans-serif;width:55px;height:24px;margin:2px;padding:0;border:0;border-radius:6px;background:#F1F3F7;color:#58677B;font-size:13px;cursor:pointer}.ds-language-selected{background:#FFFFFF;color:#005FCC}.ds-language-item:hover{background:#E4EBF4}.ds-language-item:focus-visible{outline:2px solid #005FCC;outline-offset:2px;}"
