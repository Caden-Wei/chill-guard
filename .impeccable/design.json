      "css": ".ds-nav{width:204px;padding:12px 0;background:#EFF3F8}.ds-nav-item{font-family:\"SF Pro Text\",-apple-system,BlinkMacSystemFont,sans-serif;display:block;width:172px;height:42px;margin:6px 12px;padding:0 12px;text-align:left;border:0;border-radius:9px;background:#EFF3F8;color:#17202D;font-size:13px;cursor:pointer}.ds-nav-item:hover{background:#E4EBF4}.ds-nav-item:focus-visible{outline:2px solid #005FCC;outline-offset:2px;}.ds-nav-active{background:#DDEBFF;color:#005FCC}.ds-nav-active:hover{background:#E4EBF4}"
