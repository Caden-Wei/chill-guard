      "css": ".ds-switch{font-family:\"SF Pro Text\",-apple-system,BlinkMacSystemFont,sans-serif;position:relative;display:inline-flex;align-items:center;gap:9px;color:#17202D;font-size:13px;cursor:pointer}.ds-switch-input{position:absolute;left:0;width:36px;height:20px;margin:0;opacity:0}.ds-switch-track{position:relative;width:36px;height:20px;border-radius:10px;background:#D0D7E2}.ds-switch-track:after{content:\"\";position:absolute;left:2px;top:2px;width:16px;height:16px;border-radius:50%;background:#FFFFFF}.ds-switch-input:checked+.ds-switch-track{background:#005FCC}.ds-switch-input:checked+.ds-switch-track:after{left:18px}.ds-switch:hover .ds-switch-track:after{background:#DCE6F5}.ds-switch-input:focus-visible+.ds-switch-track{outline:2px solid #005FCC;outline-offset:2px;}"
