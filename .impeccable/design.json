      "html": "<article class=\"ds-panel\"><h3 class=\"ds-panel-title\">Detection configuration</h3><div class=\"ds-panel-row\"><span>Detection model</span><span>YOLO26s</span></div><div class=\"ds-panel-row\"><span>Configured engine</span><span>Apple Core ML</span></div></article>",
